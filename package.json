{
  "name": "auto-eric",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:ts": "ts-node src/index.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs --only auto-eric-1",
    "pm2:restart": "pm2 restart auto-eric-1",
    "pm2:stop": "pm2 stop auto-eric-1",
    "pm2:logs": "pm2 logs auto-eric-1",
    "logs:file": "node scripts/show-current-log.cjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/crypto-js": "^4.2.2",
    "axios": "^1.7.9",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.3",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.5",
    "https-proxy-agent": "^7.0.6",
    "mysql2": "^3.19.0",
    "pino": "^9.5.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
